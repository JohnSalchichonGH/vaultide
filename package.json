{
  "name": "vaultide",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "lint": "pnpm -r --no-bail run lint && pnpm run lint:boundaries",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs apps packages",
    "typecheck": "pnpm -r run typecheck",
    "test:unit": "pnpm -r run test:unit",
    "test:integration": "pnpm --filter @vaultide/db run test:integration && pnpm --filter @vaultide/application run test:integration",
    "test:live": "node scripts/test-live.mjs",
    "test:e2e": "pnpm --filter @vaultide/e2e run test",
    "build": "pnpm --filter @vaultide/web run build",
    "dev": "pnpm --filter @vaultide/web run dev",
    "db:bootstrap": "node scripts/db/bootstrap.mjs",
    "db:migrate": "pnpm --filter @vaultide/db run migrate",
    "db:generate": "pnpm --filter @vaultide/db run generate",
    "db:seed-currencies": "pnpm --filter @vaultide/db run seed:currencies",
    "db:backup": "node scripts/backup/backup.mjs",
    "db:verify-dump": "node scripts/backup/verify-dump.mjs",
    "clean": "pnpm -r exec rm -rf dist .next .turbo tsconfig.tsbuildinfo",
    "db:local": "node scripts/db/local-postgres.mjs",
    "db:verify-currencies": "node scripts/db/verify-currencies.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@vaultide/application": "workspace:*",
    "@vaultide/config": "workspace:*",
    "@vitest/coverage-v8": "5.0.0",
    "age-encryption": "0.3.1",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "pg": "8.23.0",
    "server-only": "0.0.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
