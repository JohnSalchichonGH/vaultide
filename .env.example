# Vaultide environment variables (blueprint 22.2). Names only — never values.
# Each credential exists in exactly one place; nothing here is committed with a
# value, and `.env.local` is gitignored.

# ── Application ──────────────────────────────────────────────────────────────
# Public URL of this deployment, e.g. https://vaultide.app
APP_URL=
# Set automatically by CI/Vercel; shown by /api/health.
VAULTIDE_VERSION=

# ── Database (one role per consumer, blueprint 6.1 / 22.2) ───────────────────
# Runtime only: the pooled endpoint as app_user (NOBYPASSRLS, no DDL). Vercel.
DATABASE_URL=
# Migrations only: the direct endpoint as app_owner. GitHub Actions only.
DATABASE_URL_DIRECT_OWNER=
# Backups only: app_backup (SELECT + BYPASSRLS). Backup workflow only.
DATABASE_URL_BACKUP=
# One-time role bootstrap only: the platform admin. Bootstrap workflow only.
DATABASE_URL_ADMIN=

# Passwords used when creating or rotating the roles (bootstrap workflow only).
APP_OWNER_PASSWORD=
APP_USER_PASSWORD=
APP_BACKUP_PASSWORD=

# ── Backups (blueprint 22.5) ─────────────────────────────────────────────────
# age recipient public key; the private key stays offline and never enters CI.
BACKUP_AGE_PUBLIC_KEY=
BACKUP_BUCKET_NAME=
BACKUP_BUCKET_REGION=
BACKUP_BUCKET_ENDPOINT=
BACKUP_BUCKET_ACCESS_KEY_ID=
BACKUP_BUCKET_SECRET_ACCESS_KEY=

# ── Observability (blueprint 18.2) ───────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_CRON_BACKUP_URL=
LOG_LEVEL=

# ── Phase 1 onwards (declared here so the shape is known) ────────────────────
# Better Auth (17.1)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Transactional email with an EU region (17.1)
EMAIL_API_KEY=
EMAIL_FROM=
# Bearer secret for /api/cron/fx-refresh (10.4)
CRON_SECRET=

# ── Local development helpers ────────────────────────────────────────────────
# PostgreSQL 16 bin directory used by the local cluster and the backup scripts.
PGBIN=
# Integration tests: an admin URL. Defaults to the cluster from `pnpm db:local start`.
TEST_DATABASE_URL_ADMIN=
