# Vaultide environment variables (blueprint 22.2). Names only — never values.
# Each credential exists in exactly one place; nothing here is committed with a
# value, and `.env.local` is gitignored.

# ── Application ──────────────────────────────────────────────────────────────
# Public URL of this deployment, e.g. https://vaultide.app
APP_URL=
# Set automatically by CI/Vercel; shown by /api/health.
VAULTIDE_VERSION=

# ── Database (one role per consumer, blueprint 6.1 / 22.2) ───────────────────
# Runtime only: the pooled endpoint as app_user (NOBYPASSRLS, no DDL). Vercel.
DATABASE_URL=
# Migrations only: the direct endpoint as app_owner. GitHub Actions only.
DATABASE_URL_DIRECT_OWNER=
# Backups only: app_backup (SELECT + BYPASSRLS). Backup workflow only.
DATABASE_URL_BACKUP=
# One-time role bootstrap only: the platform admin. Bootstrap workflow only.
DATABASE_URL_ADMIN=

# Passwords used when creating or rotating the roles (bootstrap workflow only).
APP_OWNER_PASSWORD=
APP_USER_PASSWORD=
APP_BACKUP_PASSWORD=

# ── Backups (blueprint 22.5) ─────────────────────────────────────────────────
# age recipient public key; the private key stays offline and never enters CI.
BACKUP_AGE_PUBLIC_KEY=
BACKUP_BUCKET_NAME=
BACKUP_BUCKET_REGION=
BACKUP_BUCKET_ENDPOINT=
BACKUP_BUCKET_ACCESS_KEY_ID=
BACKUP_BUCKET_SECRET_ACCESS_KEY=

# ── Observability (blueprint 18.2) ───────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_CRON_BACKUP_URL=
LOG_LEVEL=

# ── Authentication (blueprint 17.1, 22.2) ────────────────────────────────────
# At least 32 bytes of random data (17.3). Rotating it invalidates every
# session and every unused verification and reset token.
BETTER_AUTH_SECRET=
# Where the auth routes are mounted, e.g. https://vaultide.app/api/auth
BETTER_AUTH_URL=

# ── Transactional email (blueprint 17.1) ─────────────────────────────────────
# Verification, password reset, "someone tried to sign up with your address"
# and the deletion confirmation. Without a key the capturing mailer is used,
# which is fine locally and refused in production.
EMAIL_API_KEY=
# Sender identity, e.g. "Vaultide <no-reply@vaultide.app>"
EMAIL_FROM=
# Send endpoint. Defaults to https://api.resend.com/emails; set it to whichever
# provider the deployment uses (see docs/ops/environment-setup.md on residency).
EMAIL_API_URL=
# Identifies the provider in operational logs only.
EMAIL_PROVIDER_ID=

# ── FX (blueprint 10.4) ──────────────────────────────────────────────────────
# Bearer secret Vercel Cron sends to /api/cron/fx-refresh. Any other caller
# gets a 404.
CRON_SECRET=
# Rate provider base URL. Defaults to https://api.frankfurter.dev/v2 (v1 is frozen).
FX_PROVIDER_URL=
# `fixture` swaps in the deterministic FX publisher for the end-to-end suite,
# so the browser matrix needs no public network. Honoured only where the test
# capabilities are enabled; a production deployment refuses it and logs that it
# did. Leave empty everywhere else.
FX_PROVIDER=
# Sentry cron monitor check-in URL for the daily refresh (22.6).
SENTRY_CRON_FX_URL=

# ── Local development helpers ────────────────────────────────────────────────
# PostgreSQL 16 bin directory used by the local cluster and the backup scripts.
PGBIN=
# Integration tests: an admin URL. Defaults to the cluster from `pnpm db:local start`.
TEST_DATABASE_URL_ADMIN=
