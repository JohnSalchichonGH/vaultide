{
  "extends": "@vaultide/config/tsconfig.base.json",
  "compilerOptions": {
    // page.evaluate() bodies run in the browser, so the suite needs DOM types.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
